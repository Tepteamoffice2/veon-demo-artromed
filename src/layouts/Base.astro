---
import "@fontsource/onest/400.css";
import "@fontsource/onest/600.css";
import "@fontsource/geologica/600.css";
import onestCyr400 from "@fontsource/onest/files/onest-cyrillic-400-normal.woff2?url";
import "../styles/tokens.css";
import "../styles/global.css";
import "../styles/site.css";
import "../styles/sections.css";

interface Props { lang: string; title: string; description: string; canonical?: string; }
const { lang, title, description, canonical } = Astro.props;
---
<!doctype html>
<html lang={lang} data-rec="R-003,R-110,R-202,R-204">
  <head>
    <meta charset="utf-8" />
    <script is:inline>document.documentElement.classList.add("js")</script>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {canonical && <link rel="canonical" href={canonical} />}
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:locale" content="uk_UA" />
    <meta name="theme-color" content="#FAFBFC" />
    <meta name="robots" content="noindex" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preload" href={onestCyr400} as="font" type="font/woff2" crossorigin />
    <slot name="head" />
    <style is:global>html, body { overflow-x: clip; }</style>
  </head>
  <body id="top">
    <a class="skip-link" href="#main" data-rec="R-207">{lang.startsWith("uk") ? "До змісту" : lang.startsWith("ru") ? "К содержанию" : "Skip to content"}</a>
    <slot name="header" />
    <main id="main" data-rec="R-305"><slot /></main>
    <slot name="footer" />
    <script src="../scripts/reveal.ts"></script>
  </body>
</html>
